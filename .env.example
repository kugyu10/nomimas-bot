# nomimas 環境変数テンプレート
# 実際の値は env.dev / env.prod に置く（gitignore 済み・コミット禁止）

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DIRECT_CONNECTION_STRING=
DEV_PROJECT_REF=

# LINE Messaging API
# アクセストークンは実行時にステートレストークン(v3)を都度発行するため env には置かない
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# X (Twitter) OAuth (Supabase Auth 用)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
